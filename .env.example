# ============================================================================
# Plantilla de variables de entorno para Nomi.
# Copiar este archivo a .env.local y completar con valores reales.
# .env.local esta en .gitignore — NUNCA subirlo al repo.
# ============================================================================

# Base de datos — Railway PostgreSQL
# Crear proyecto en https://railway.app, agregar plugin PostgreSQL
# y copiar la connection URL desde Connect -> Postgres Connection URL
DATABASE_URL="postgresql://user:password@host:5432/nomi"

# Clerk — https://clerk.com (crear app -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Generar despues en Clerk Dashboard -> Webhooks -> Add Endpoint -> Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/branding

# Uploadthing v7+ — https://uploadthing.com -> tu app -> API Keys
# Usar el token unificado (base64 con apiKey + appId + region)
UPLOADTHING_TOKEN=eyJhcGlL...

# Stripe — https://stripe.com -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_...
# Generar con `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Crear 3 productos recurrentes en ARS y pegar los price IDs:
#   Starter $8.000 / Pro $18.000 / Multi $35.000 (mensuales)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MULTI=price_...

# OpenAI — https://platform.openai.com -> API Keys
OPENAI_API_KEY=sk-...

# Replicate — https://replicate.com/account/api-tokens
# Un solo token; nombre exacto: REPLICATE_API_TOKEN
# En Railway: misma variable en el servicio Next.js (o variable compartida).
# Se usa para:
#   - Mejorar foto del item (POST /api/ai/enhance) — Real-ESRGAN
#   - Modo "Solo nitidez" y preprocess en Imágenes IA — Real-ESRGAN
#   - Generación Flux 1.1 Pro (text-to-image) cuando aplica — lib/flux.ts
REPLICATE_API_TOKEN=r8_...

# Resend — https://resend.com -> API Keys
RESEND_API_KEY=re_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
